            "fhirPath": "Encounter.period.start"
          },
          {
            "columnName": "period_end",
            "fhirPath": "Encounter.period.end"
          },
          {
            "columnName": "reason_code_system",
            "fhirPath": "Encounter.reasonCode[0].coding[0].system"
          },
          {
            "columnName": "reason_code",
            "fhirPath": "Encounter.reasonCode[0].coding[0].code"
          },
          {
            "columnName": "reason_code_display",
            "fhirPath": "Encounter.reasonCode[0].coding[0].display"
          },
          {
            "columnName": "location_id",
            "fhirPath": "Encounter.location[0].location.reference.replace('Location/', '')"
          }
        ]
      }
    ]
  },
  {
    "resourceType": "Observation",
    "tableMappings": [
      {
        "targetTable": "observation_example",
